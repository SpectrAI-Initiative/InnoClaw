# ssm-region=ap-shanghai
# ssm-secret=innobuddy-docker-online
# ssm-version=v1
# 线上 Docker。非秘钥改这个文件。AUTH_SECRET 和 DEEPSEEK_API_KEY 在 SSM innobuddy-docker-online。
# 启动：./scripts/docker-up-online.sh 会生成 .env.docker.online，不要提交那个文件。
# 浏览器：http://<虚拟机IP>:3000
PUBLISH_PORT=3000
HOST_WORKSPACE_PATH=/data/innobuddy/research
WORKSPACE_ROOTS=/research
AUTH_MODE=local
AUTH_SINGLE_ADMIN=true
AUTH_COOKIE_SECURE=false
AUTH_SECRET=ssm:AUTH_SECRET
DEEPSEEK_API_KEY=ssm:DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://tokenhub.tencentmaas.com/v1
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4.1-flash
