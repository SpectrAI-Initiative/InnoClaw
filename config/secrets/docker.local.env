# ssm-region=ap-shanghai
# ssm-secret=innobuddy-docker-local
# ssm-version=v1
# 本地 Docker。非秘钥改这个文件。AUTH_SECRET 和 DEEPSEEK_API_KEY 在 SSM innobuddy-docker-local。
# 启动：.\scripts\docker-up-local.ps1 会生成 .env.docker.local，不要提交那个文件。
# 浏览器：http://127.0.0.1:3000
PUBLISH_PORT=3000
HOST_WORKSPACE_PATH=./workspace
WORKSPACE_ROOTS=/research
AUTH_MODE=local
AUTH_SINGLE_ADMIN=false
AUTH_COOKIE_SECURE=false
AUTH_SECRET=ssm:AUTH_SECRET
DEEPSEEK_API_KEY=ssm:DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://tokenhub.tencentmaas.com/v1
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4.1-flash
