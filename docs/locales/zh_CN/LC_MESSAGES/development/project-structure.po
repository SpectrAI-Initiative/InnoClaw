#: ../../development/project-structure.md:1 b61d4f06471e41588e4df4f866bc689a
msgid "Project Structure"
msgstr "项目结构"

#: ../../development/project-structure.md:3 deabb014386846a48d1cde8a6dfec837
msgid ""
"This page describes the directory layout and module organization of "
"InnoClaw."
msgstr "本页介绍 InnoClaw 的目录布局和模块组织。"

#: ../../development/project-structure.md:5 1a242ed85aa24b7b89725cf8315d0df5
msgid "High-Level Structure"
msgstr "高层结构"

#: ../../development/project-structure.md:54 afeca5a2dbae4b28b1f1e4d7079e8427
msgid "Directory Layout"
msgstr "目录布局"

#: ../../development/project-structure.md:183 8da2f5753aa84c91ac9a32ac9c82c439
msgid "Key Modules"
msgstr "核心模块"

#: ../../development/project-structure.md:185 bdf8f7deec074cf8a80ba974df3c3ce2
msgid "App Router (`src/app/`)"
msgstr "App Router（`src/app/`）"

#: ../../development/project-structure.md:187 5b57e85005a44855b8dbb14e24dea630
msgid ""
"Next.js 16 App Router with file-based routing. Pages are server "
"components by default; client components use the `\"use client\"` "
"directive."
msgstr "Next.js 16 App Router，基于文件的路由。页面默认为服务器组件；客户端组件使用 `\\\"use client\\\"` 指令。"

#: ../../development/project-structure.md:189 6e645f68b2ee4afc9cc71345b222753a
msgid "Components (`src/components/`)"
msgstr "组件（`src/components/`）"

#: ../../development/project-structure.md:191 7bdcd2b416ff442f89b79150b0d2c549
msgid ""
"React components organized by feature area. Uses shadcn/ui as the base "
"component library with Tailwind CSS for styling."
msgstr "按功能区域组织的 React 组件。使用 shadcn/ui 作为基础组件库，Tailwind CSS 进行样式设计。"

#: ../../development/project-structure.md:193 44d3b2d3c11f47a48c8dab2597e61700
msgid "Database (`src/lib/db/`)"
msgstr "数据库（`src/lib/db/`）"

#: ../../development/project-structure.md:195 bf46cf1220be405896bf1471e042ce72
#, fuzzy
msgid ""
"SQLite database managed by Drizzle ORM. The schema defines 11 tables: "
"workspaces, sources, source chunks, chat messages, notes, app settings, "
"skills, scheduled tasks, cluster operations, HF datasets, and dataset-"
"workspace links."
msgstr "由 Drizzle ORM 管理的 SQLite 数据库。Schema 定义了工作空间、来源、来源分块、分块嵌入、对话消息、笔记、设置和技能的表。"

#: ../../development/project-structure.md:197 3fa91b60fbeb4ceaa26d07db310f281a
msgid "RAG Pipeline (`src/lib/rag/`)"
msgstr "RAG 流水线（`src/lib/rag/`）"

#: ../../development/project-structure.md:199 850e54d8b9e44b02893b63b8305a8e82
msgid ""
"The Retrieval-Augmented Generation pipeline handles text chunking, vector"
" embedding, storage, and similarity search. Uses pure JavaScript cosine "
"similarity — no external vector database needed."
msgstr "检索增强生成流水线处理文本分块、向量嵌入、存储和相似性搜索。使用纯 JavaScript 余弦相似度 —— 无需外部向量数据库。"

#: ../../development/project-structure.md:201 dd74770abd414b14ae1b55a604a47fe5
#, fuzzy
msgid "AI Providers (`src/lib/ai/`)"
msgstr "RAG 流水线（`src/lib/rag/`）"

#: ../../development/project-structure.md:203 25ed39d96831467db1c83ef11fc1842b
msgid ""
"Configures and routes requests to OpenAI, Anthropic, and Gemini "
"providers. Includes model definitions, agent tool implementations, and "
"skill system integration."
msgstr ""

#: ../../development/project-structure.md:205 b3c165f23faa4fe49b02acee25f55771
msgid "Bot Integrations (`src/lib/bot/`)"
msgstr "机器人集成（`src/lib/bot/`）"

#: ../../development/project-structure.md:207 8fbe4423b8a348178383eeb9ef4ceb70
#, fuzzy
msgid ""
"Implements the `BotAdapter` interface for Feishu (Lark) and WeChat "
"Enterprise. Each adapter handles webhook verification, message parsing, "
"response formatting, and interactive card-based progress tracking."
msgstr "为飞书和企业微信实现了 `BotAdapter` 接口。每个适配器处理 Webhook 验证、消息解析和响应格式化。"

#: ../../development/project-structure.md:209 532a068df701463a9904997de98f47ab
msgid "Article Search (`src/lib/article-search/`)"
msgstr ""

#: ../../development/project-structure.md:211 f5d91b3b05d9490eb08a06f83a07a298
msgid ""
"Search engine for academic papers across arXiv and Hugging Face Daily "
"Papers. Supports keyword search, date filtering, related article "
"discovery, and result caching."
msgstr ""

#: ../../development/project-structure.md:213 a0110e418bcc43aab2b5ece42efc4e84
#, fuzzy
msgid "Cluster Operations (`src/lib/cluster/`)"
msgstr "机器人集成（`src/lib/bot/`）"

#: ../../development/project-structure.md:215 adf721497db540138e529be89755bba0
msgid ""
"Kubernetes cluster integration for GPU-accelerated workloads. Records "
"operation audit trail and validates kubectl/vcctl inputs."
msgstr ""

#: ../../development/project-structure.md:217 52cca7d5fff744ae871dc3a7192fd1b4
msgid "Dataset Management (`src/lib/hf-datasets/` and `src/lib/modelscope/`)"
msgstr ""

#: ../../development/project-structure.md:219 af72651ff97948f8a948fa95a73285c2
msgid ""
"Download orchestration for datasets from HuggingFace Hub and ModelScope. "
"Supports pause/resume/cancel, progress tracking, manifest computation, "
"and dataset preview."
msgstr ""

#: ../../development/project-structure.md:221 f66139443abe49468d995e40419b2749
msgid "Report Generation (`src/lib/daily-report.ts`, `src/lib/weekly-report.ts`)"
msgstr ""

#: ../../development/project-structure.md:223 b81e9e3342ef442c855695570633b6ac
msgid ""
"AI-powered report generation that analyzes workspace activity (git "
"commits, file changes, chat history) to produce structured daily and "
"weekly summaries."
msgstr ""

#: ../../development/project-structure.md:225 8aeae05b376d43dda80421a255f1fc70
msgid "Task Scheduler (`src/lib/scheduler.ts`)"
msgstr ""

#: ../../development/project-structure.md:227 6eb35f53fa4b4ce6ac4429ad6dd29e7e
msgid ""
"Cron-based task execution engine. Polls every 60 seconds and dispatches "
"handlers for each task type (daily_report, weekly_report, git_sync, "
"source_sync, custom)."
msgstr ""
