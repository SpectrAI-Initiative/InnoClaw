msgstr "`main` —— 稳定的生产分支"

#: ../../development/contributing.md:105 20f8fc8f21b7463999198fbde8830a3b
msgid "Feature branches — Created from `main` for new features or bug fixes"
msgstr "功能分支 —— 从 `main` 创建，用于新功能或错误修复"

#: ../../development/contributing.md:107 ed1fcbc9747d44b49946fe5b8cceddd6
msgid "Branch Naming Convention"
msgstr "分支命名规范"

#: ../../development/contributing.md:115 9fb86c18200a4eac84f700aaaddc7ec0
msgid "Commit Conventions"
msgstr "提交规范"

#: ../../development/contributing.md:117 3c4f055d3fb242a584f1680378f450db
msgid "We follow [Conventional Commits](https://www.conventionalcommits.org/):"
msgstr "我们遵循 [Conventional Commits](https://www.conventionalcommits.org/) 规范："

#: ../../development/contributing.md:125 471fd6970d1a46febc17d5be40bb1b3b
msgid "Commit Types"
msgstr "提交类型"

#: ../../development/contributing.md:77 37f773e79be043b7abefb5e84102453e
msgid "Type"
msgstr "类型"

#: ../../development/contributing.md:77 e8f64d791df24a8e874db6742d188ec6
msgid "Description"
msgstr "描述"

#: ../../development/contributing.md:77 2179daba3a49456a8bd059ee15098d55
msgid "`feat`"
msgstr "`feat`"

#: ../../development/contributing.md:77 2ed21affcb9c46b099c4a8e7222d1212
msgid "A new feature"
msgstr "新功能"

#: ../../development/contributing.md:77 555fbb4e666e402eae3d855441eed408
msgid "`fix`"
msgstr "`fix`"

#: ../../development/contributing.md:77 1f346f5f7fc44392a46a2ec71da8c7e5
