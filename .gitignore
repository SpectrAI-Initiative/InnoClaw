# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.admin-cli/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
.dev.pid
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# Claude Code local config
.claude/

# research history
history/

# runtime state
/data/
/backups/
/logs/
/outputs/
/workspaces/

# typescript
*.tsbuildinfo
next-env.d.ts

# cluster config
config/*
!config/d_k8s_job.yaml
!config/skills/
!config/skills/**
!config/k8s-job-profiles.example.json
config/k8s-job-profiles.local.json

# docs build artifacts
docs/_build/
.venv-docs/
docs/locales/*/LC_MESSAGES/*.mo
docs/locales/*/LC_MESSAGES/**/*.mo
reference/
batch-test-logs/
.worktrees/
